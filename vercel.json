{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "redirects": [
    { "source": "/pricing", "destination": "/book-now", "permanent": true },
    { "source": "/booking", "destination": "/book-now", "permanent": true },
    { "source": "/admin", "destination": "https://www.bookaride.co.nz/admin", "permanent": false },
    { "source": "/admin/:path*", "destination": "https://www.bookaride.co.nz/admin/:path*", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://www.bookaride.co.nz/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
